modules = ["nodejs-20"]
[agent]
expertMode = true
stack = "BEST_EFFORT_FALLBACK"

[nix]
channel = "stable-25_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Kingdom Bot"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Community Bot"

[[workflows.workflow]]
name = "Kingdom Bot"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node src/index.js"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "Community Bot"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node community-bot/src/index.js"

[workflows.workflow.metadata]
outputType = "console"

[[ports]]
localPort = 3000
externalPort = 3001

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5001
externalPort = 3000

[deployment]
deploymentTarget = "vm"
run = ["node", "src/index.js"]
